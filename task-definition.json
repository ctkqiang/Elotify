{
  "family": "pushservice",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::637810847194:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::637810847194:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "mongodb",
      "image": "mongo:7.0",
      "essential": true,
      "memory": 1024,
      "portMappings": [
        {
          "containerPort": 27017,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "MONGO_INITDB_ROOT_USERNAME",
          "value": "admin"
        },
        {
          "name": "MONGO_INITDB_ROOT_PASSWORD",
          "value": "vf1300177"
        },
        {
          "name": "MONGO_INITDB_DATABASE",
          "value": "value_farm_notification"
        }
      ],
      "command": [
        "bash", "-c",
        "mongod --auth --bind_ip_all --wiredTigerCacheSizeGB 0.5 & sleep 10 && mongosh admin --eval \\\"db.createUser({user: 'admin', pwd: 'vf1300177', roles: [{role: 'root', db: 'admin'}], mechanisms: ['SCRAM-SHA-256']})\\\" && wait"
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "mongosh --username admin --password vf1300177 --authenticationDatabase admin --eval 'db.runCommand(\"ping\")' --quiet || exit 1"
        ],
        "interval": 60,
        "timeout": 30,
        "retries": 3,
        "startPeriod": 120
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/pushservice",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "mongodb"
        }
      }
    },
    {
      "name": "pushservice-app",
      "image": "637810847194.dkr.ecr.ap-southeast-1.amazonaws.com/pushservice:latest",
      "essential": true,
      "memory": 1024,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "80"
        },
        {
          "name": "MONGODB_URI",
          "value": "mongodb://admin:vf1300177@localhost:27017/value_farm_notification?authSource=admin&retryWrites=true&w=majority&maxPoolSize=10&serverSelectionTimeoutMS=30000&connectTimeoutMS=30000"
        },
        {
          "name": "MODE",
          "value": "release"
        },
        {
          "name": "MONGODB_USER",
          "value": "admin"
        },
        {
          "name": "MONGODB_PASSWORD",
          "value": "vf1300177"
        },
        {
          "name": "MONGODB_DATABASE",
          "value": "value_farm_notification"
        },
        {
          "name": "MONGODB_HOST",
          "value": "localhost"
        },
        {
          "name": "MONGODB_PORT",
          "value": "27017"
        },
        {
          "name": "ONESIGNAL_APP_ID",
          "value": "85d94c8e-8aed-4d7f-901a-6d1793ce532e"
        },
        {
          "name": "ONESIGNAL_REST_API_KEY",
          "value": "os_v2_app_qxmuzduk5vgx7ea2nulzhtstf3tgr6qtl4dumr454e5wqwfgr5ns4mku5cixvacdul3j2ylt4w6tjasx76i2qbimu324uvbuc4kocri"
        },
        {
          "name": "MYSQL_USER",
          "value": "gp_cheng"
        },
        {
          "name": "MYSQL_PASSWORD",
          "value": "7K$ZKd3o8i"
        },
        {
          "name": "MYSQL_HOST",
          "value": "valuefarm.com"
        },
        {
          "name": "MYSQL_PORT",
          "value": "3306"
        },
        {
          "name": "MYSQL_DATABASE",
          "value": "gpecomm"
        },
        {
          "name": "JWE_KEY_AES_256",
          "value": "vAluEfArmPriceFeEd"
        },
        {
          "name": "ENCRYPT",
          "value": "false"
        }
      ],
      "dependsOn": [
        {
          "containerName": "mongodb",
          "condition": "HEALTHY"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:80/health || exit 1"
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/pushservice",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "pushservice-app"
        }
      }
    }
  ]
}
